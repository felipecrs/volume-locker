{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update usbip-win2, which the end-to-end tests install",
      "managerFilePatterns": ["/^e2e/src/usbip_win2\\.rs$/"],
      "matchStrings": ["const VERSION: &str = \"(?<currentValue>[^\"]+)\";"],
      "depNameTemplate": "vadimgrn/usbip-win2",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v\\.(?<version>.+)$",
      "versioningTemplate": "loose"
    }
  ]
}
